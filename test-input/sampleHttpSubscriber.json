    "journalResumeThresholdSize": 0,
  },
  "ssl": {
    "Key Store Passphrase": "changeit",
    "Key Store": "./test-input/TLS_CA_Signed/server/jal_subscriber_v2_server.jks",

    "Trust Store Passphrase": "changeit",
    "Trust Store": "./test-input/TLS_CA_Signed/server/jal_subscriber_v2_server-remotes.jks"
  }
}
