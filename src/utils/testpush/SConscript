Import('*')
from Utils import add_project_lib

env = env.Clone()

env.MergeFlags({'CPPPATH':'#src/network_lib/src:#src/lib_common/include:#src/network_lib/include:#src/lib_common/src:#src/lmdb_layer/src/:.'.split(':')})
add_project_lib(env, 'lmdb_layer', 'jal-db')

env.MergeFlags('-pthread')

env.MergeFlags(env['lmdb_cflags'])
env.MergeFlags(env['lmdb_ldflags'])

testpush = env.Program(target='dummy_push', source=["push.c", lib_common, network_lib])

env.Default(testpush)
